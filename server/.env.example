PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# In production, set NODE_ENV=production and CLIENT_URL to your HTTPS frontend origin.
# Set CLIENT_ORIGIN only when an additional trusted HTTPS origin is required.
# Set TRUST_PROXY=1 only when the API is behind one trusted reverse proxy.
TRUST_PROXY=0
MONGODB_URI=mongodb://127.0.0.1:27017/university_lms
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=12h
ASSIGNMENT_MAX_FILE_SIZE=10485760
ASSIGNMENT_ATTACHMENT_MAX_FILE_SIZE=15728640
ADMIN_NAME=University Administrator
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace_with_a_unique_12_character_password
