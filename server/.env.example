PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# In production, set NODE_ENV=production and CLIENT_URL to your HTTPS frontend origin.
# Set CLIENT_ORIGIN only when an additional trusted HTTPS origin is required.
# Set TRUST_PROXY=1 only when the API is behind one trusted reverse proxy.
TRUST_PROXY=0
MONGODB_URI=mongodb://127.0.0.1:27017/university_lms
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=12h
ASSIGNMENT_MAX_FILE_SIZE=10485760
ASSIGNMENT_ATTACHMENT_MAX_FILE_SIZE=15728640
ADMIN_NAME=University Administrator
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace_with_a_unique_12_character_password

# Email Provider
EMAIL_PROVIDER=resend

# Resend Configuration (never commit the key; it stays on the backend only)
RESEND_API_KEY=
EMAIL_FROM="DARSIVO LMS <noreply@techrosolutions.com>"
# Optional: inbox that receives the admin "Test & resume" email (defaults to the admin's own address)
EMAIL_TEST_RECIPIENT=

# Application URL
# Public URL used in verification links: the frontend origin (Vite dev server: http://localhost:5173).
APP_URL=http://localhost:5173

# Email Verification Settings
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS_PER_DAY=5

# Notification email queue (Resend free plan: 100/day, 3000/month)
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
EMAIL_DAILY_RESERVED_FOR_ACCOUNT=20
EMAIL_MAX_PER_MINUTE=30
EMAIL_JOB_MAX_AGE_HOURS=72

# Sign-in security
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60

# Optional upload virus scanning with ClamAV (leave empty to turn off)
CLAMAV_HOST=
CLAMAV_REQUIRED=false
